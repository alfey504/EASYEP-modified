# ==========================================
# MODEL CONFIGURATION
# ==========================================

# Local model directory. Leave empty to download HF_MODEL_ID.
# A non-empty invalid path is an error (no silent fallback to a download).
MODEL_PATH=
HF_MODEL_ID=google/switch-base-8
HF_REVISION=

# float32 | float16 | bfloat16
MODEL_DTYPE=float32

# Extra model plugin modules (comma-separated), e.g. my_package.mixtral_plugin.
# Built-in plugins (switch_transformers, olmoe) are always available.
MODEL_PLUGINS=

# Download cache for Hugging Face models (empty = default ~/.cache/huggingface)
HF_CACHE_DIR=

# Experts kernel for transformers 5 fused-expert models (empty = transformers default;
# eager | grouped_mm | batched_mm)
EXPERTS_IMPLEMENTATION=

# ==========================================
# DEVICE CONFIGURATION
# ==========================================

# auto (CUDA -> MPS -> CPU) | cuda | mps | cpu
DEVICE=auto

# Split the model over several GPUs: empty = whole model on DEVICE;
# auto | balanced | balanced_low_0 | sequential | JSON {"module": "cuda:0", ...}
DEVICE_MAP=
# Per-device memory cap for DEVICE_MAP, e.g. 0:13GiB,1:13GiB
MAX_MEMORY=

# ==========================================
# DATASET CONFIGURATION
# ==========================================

CALIBRATION_DATASET_PATH=./data/calibration.jsonl
EVALUATION_DATASET_PATH=./data/evaluation/c4_support_eval.jsonl

CALIBRATION_MAX_SAMPLES=128
CALIBRATION_BATCH_SIZE=1

MAX_SOURCE_LENGTH=256
MAX_TARGET_LENGTH=128

# ==========================================
# C4 EVALUATION DATASET
# ==========================================

C4_DATASET_ID=allenai/c4
C4_CONFIG=en
C4_SPLIT=validation

C4_DOMAIN=support

C4_MAX_SAMPLES=500
C4_MAX_SCANNED=100000
C4_MIN_TEXT_LENGTH=200
C4_MAX_TEXT_LENGTH=8000
C4_MIN_KEYWORD_MATCHES=2

C4_SUPPORT_KEYWORDS=customer support,technical support,customer service,help center,help centre,troubleshooting,frequently asked questions,FAQ,refund policy,return policy,warranty claim,order tracking,billing support,account recovery,password reset,error code,support ticket,knowledge base,help desk

C4_URL_KEYWORDS=support,help,faq,knowledge-base,customer-service

# Optional comma-separated list of domains (e.g. support.example.com,example.org)
C4_ALLOWED_DOMAINS=

# ==========================================
# EXPERT PRUNING
# ==========================================

PRUNING_METHOD=easyep

PRUNE_EXPERTS_PER_LAYER=2

# Use "first" for initial testing.
# Use "all" to prune every detected sparse layer.
# Also support comma-separated layer identifiers (e.g. encoder.block.1,decoder.block.3).
PRUNE_LAYERS=first

# What to do with experts that received no calibration tokens:
# exclude (default) = never select them; allow = may be selected (zero-bias fallback, logged)
PRUNE_UNOBSERVED_POLICY=exclude

# How selected experts are replaced:
#   bias    = trainable gate-scaled bias vector g*b (BiasExpert)
#   drop    = expert removed, its tokens get zero MoE output (router unchanged)
#   reroute = expert removed, its tokens go to their best remaining expert
#             (gate = that expert's original router probability)
REPLACEMENT_METHOD=bias

# ==========================================
# BIAS INITIALIZATION
# ==========================================

BIAS_INITIALIZATION=gate_token_weighted_mean

# ==========================================
# BIAS TRAINING
# ==========================================

BIAS_TRAINING_OBJECTIVE=layer_mse

BIAS_LEARNING_RATE=0.001
BIAS_TRAINING_STEPS=100
BIAS_BATCH_SIZE=1

BIAS_VALIDATION_FRACTION=0.1
# Evaluate the validation loss every N optimisation steps
BIAS_EVAL_INTERVAL=10

# ==========================================
# EVALUATION
# ==========================================

EVAL_MAX_SAMPLES=500
EVAL_BATCH_SIZE=1

EVAL_NOISE_DENSITY=0.15
EVAL_MEAN_SPAN_LENGTH=3.0
EVAL_SEED=42
# Number of examples shown in the qualitative (generation) comparison
EVAL_QUALITATIVE_SAMPLES=3

# ==========================================
# REPRODUCIBILITY
# ==========================================

SEED=42

# ==========================================
# OUTPUT PATHS
# ==========================================

# Every experiment writes into EXPERIMENT_DIR/EXPERIMENT_NAME
EXPERIMENT_NAME=switch8-easyep-first

PRUNED_MODEL_PATH=./outputs/pruned-model

EXPERIMENT_DIR=./outputs/experiments
STATS_DIR=./outputs/stats
CACHE_DIR=./outputs/cache

LOG_LEVEL=INFO

# full = self-contained checkpoints; delta = only bias vectors + manifest (rebuilt from the
# base model on load; for limited disk such as Kaggle)
CHECKPOINT_FORMAT=full
