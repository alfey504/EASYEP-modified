# Model profile: google/switch-base-8 (encoder-decoder, 8 experts, top-1).
# Layered on top of .env:  uv run python scripts/<step>.py --profile configs/switch-base-8.env
MODEL_PATH=
HF_MODEL_ID=google/switch-base-8
MODEL_DTYPE=float32

MAX_SOURCE_LENGTH=256
MAX_TARGET_LENGTH=128

PRUNE_EXPERTS_PER_LAYER=2
PRUNE_LAYERS=first

EXPERIMENT_NAME=switch8-easyep-first
PRUNED_MODEL_PATH=./outputs/pruned-switch-base-8
