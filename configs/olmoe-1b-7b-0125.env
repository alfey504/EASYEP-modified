# Model profile: allenai/OLMoE-1B-7B-0125 (decoder-only, 16 MoE layers x 64 experts, top-8),
# the model used in the STEP repository.
# Layered on top of .env:  uv run python scripts/<step>.py --profile configs/olmoe-1b-7b-0125.env
#
# Memory: 6.9B parameters = ~28 GB in float32, ~14 GB in bfloat16. This does NOT fit a 16 GB Mac;
# use a GPU with >= 24 GB (bfloat16) and >= 40 GB free disk for the download and checkpoints.
MODEL_PATH=
HF_MODEL_ID=allenai/OLMoE-1B-7B-0125
MODEL_DTYPE=bfloat16

# Causal LM: MAX_SOURCE_LENGTH = prompt tokens (calibration) and document tokens (evaluation),
# MAX_TARGET_LENGTH = response tokens (calibration).
MAX_SOURCE_LENGTH=512
MAX_TARGET_LENGTH=256

# 64 experts per layer: e.g. 16 = 25% of the routed experts in every layer.
PRUNE_EXPERTS_PER_LAYER=16
PRUNE_LAYERS=all

CALIBRATION_BATCH_SIZE=1
EVAL_BATCH_SIZE=1

EXPERIMENT_NAME=olmoe-1b-7b-easyep
PRUNED_MODEL_PATH=./outputs/pruned-olmoe-1b-7b
