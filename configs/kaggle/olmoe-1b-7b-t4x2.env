# Kaggle profile: allenai/OLMoE-1B-7B-0125 on "GPU T4 x2" (2 x 15 GB).
# Layered on top of .env:  python scripts/<step>.py --profile configs/kaggle/olmoe-1b-7b-t4x2.env
#
# - float16: T4 GPUs have no native bfloat16. inspect_model.py stops with a clear error if
#   float16 overflows (inf/NaN).
# - DEVICE_MAP=auto splits the 16 layers over both GPUs (~6.9 GB of weights each).
# - CHECKPOINT_FORMAT=delta stores only bias vectors + manifest (MBs) instead of a 14 GB copy
#   per stage; checkpoints are rebuilt from the base model on load.
# - Large, re-creatable files (HF download, layer cache) go to /kaggle/temp, which is not
#   counted in the 20 GB /kaggle/working limit (but is lost when the session ends).

# Base model. After running scripts/convert_model.py once and saving the result as a Kaggle
# Dataset, set MODEL_PATH=/kaggle/input/<dataset> to skip the 28 GB float32 download.
MODEL_PATH=
HF_MODEL_ID=allenai/OLMoE-1B-7B-0125
MODEL_DTYPE=float16
HF_CACHE_DIR=/kaggle/temp/hf
EXPERTS_IMPLEMENTATION=

DEVICE=cuda
DEVICE_MAP=auto
MAX_MEMORY=0:13GiB,1:13GiB

CALIBRATION_DATASET_PATH=/kaggle/input/easyep-data/calibration.jsonl
EVALUATION_DATASET_PATH=/kaggle/input/easyep-data/c4_support_eval.jsonl

MAX_SOURCE_LENGTH=512
MAX_TARGET_LENGTH=256
CALIBRATION_BATCH_SIZE=1
EVAL_BATCH_SIZE=1

PRUNE_EXPERTS_PER_LAYER=16
PRUNE_LAYERS=all

CHECKPOINT_FORMAT=delta
EXPERIMENT_NAME=olmoe-1b-7b-easyep
EXPERIMENT_DIR=/kaggle/working/outputs/experiments
STATS_DIR=/kaggle/working/outputs/stats
CACHE_DIR=/kaggle/temp/cache
PRUNED_MODEL_PATH=/kaggle/working/outputs/pruned-olmoe-1b-7b
