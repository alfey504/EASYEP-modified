# Kaggle profile: google/switch-base-8 on one T4 (the model is 2.4 GB in float32).
# Layered on top of .env:  python scripts/<step>.py --profile configs/kaggle/switch-base-8-t4.env
#
# float32 on purpose: T5-family models are known to overflow in float16.

MODEL_PATH=
HF_MODEL_ID=google/switch-base-8
MODEL_DTYPE=float32
HF_CACHE_DIR=/kaggle/temp/hf

DEVICE=cuda
DEVICE_MAP=

CALIBRATION_DATASET_PATH=/kaggle/input/easyep-data/calibration.jsonl
EVALUATION_DATASET_PATH=/kaggle/input/easyep-data/c4_support_eval.jsonl

MAX_SOURCE_LENGTH=256
MAX_TARGET_LENGTH=128

PRUNE_EXPERTS_PER_LAYER=2
PRUNE_LAYERS=first

CHECKPOINT_FORMAT=delta
EXPERIMENT_NAME=switch8-easyep-first
EXPERIMENT_DIR=/kaggle/working/outputs/experiments
STATS_DIR=/kaggle/working/outputs/stats
CACHE_DIR=/kaggle/temp/cache
PRUNED_MODEL_PATH=/kaggle/working/outputs/pruned-switch-base-8
